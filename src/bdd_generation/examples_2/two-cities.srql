# Museum Artifact Search
#
# A museum has 3 wings: West, Central, and East. Each wing has multiple rooms.
# A valuable artifact has been misplaced somewhere in the museum.
# Security robots must determine: Is the artifact in the West OR East wing?
# (i.e., is it NOT in the Central wing?)
#
# The robots start in the Central wing. Good variable ordering will:
# - Check nearby Central rooms first (to potentially answer NO quickly)
# - Coordinate robots to search West and East wings in parallel
#
# Bad variable ordering might send both robots to the same wing first.

# WEST WING (far left)
location westLobby at 0, 0
location westGallery at 0, 5
location westStorage at 0, 10

# CENTRAL WING (middle - robots start here)
location centralLobby at 50, 0
location centralHall at 50, 5

# EAST WING (far right)
location eastLobby at 100, 0

robots 2
robot security1 starts-at centralLobby
robot security2 starts-at centralHall

recognizable-property artifact

# Artifact is at exactly one location in the museum
{
  artifact(westLobby) | artifact(westGallery) | artifact(westStorage) |
  artifact(centralLobby) | artifact(centralHall) |
  artifact(eastLobby)
}

# Only one artifact exists (mutual exclusion)
[?u, ?v | ?u != ?v]{
  artifact(?u) -> !artifact(?v)
}

# Query: Is the artifact in the West wing?
#
# To answer YES: Find artifact in West
#
# Good ordering: Go to East Wing
# Bad ordering: Check West Wing
Query: {
  (artifact(westLobby)) | (artifact(westGallery)) | (artifact(westStorage))
}
