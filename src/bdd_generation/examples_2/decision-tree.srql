# Decision Tree Query (BDD structure)
#
# BDD levels (one variable per level):
#
#   Level 0:         a
#                  /   \
#   Level 1:     d       b
#               / \     / \
#   Level 2:  e    T   c    T
#            / \       / \
#   Leaves: F   T     F   T
#
# Left = false, Right = true at every node.
#
# Traversal:
#   Check a first (signpost: art(a) free, not mutually exclusive with b–e).
#   a=true  (right) -> check b.  b=true -> T.  b=false -> check c.  c=true -> T.  c=false -> F.
#   a=false (left)  -> check d.  d=true -> T.  d=false -> check e.  e=true -> T.  e=false -> F.
#
# Layout:
#
#   b (0, 60)                     d (100, 60)
#       \                         /
#   c (0, 40)      a (50, 50)    e (100, 40)
#                  /
#          hub (50, 20)
#
# Good ordering: a, b, c, d, e  (a at top, branches grouped)
# Bad ordering:  b before a wastes a trip when a turns out false.

# ROBOT HUB (starting point, not part of any wing)
location hub at 50, 20

# LEVEL 0 — root observation
location a at 50, 50

# LEVEL 1/2 — true branch (left wing)
location b at 0, 60
location c at 0, 40

# LEVEL 1/2 — false branch (right wing)
location d at 100, 60
location e at 100, 40

robots 2
robot r1 starts-at hub
robot r2 starts-at hub

recognizable-property art

# No artifact at hub
!art(hub)

# World: at least one artifact among b, c, d, e
{
  art(b) | art(c) | art(d) | art(e)
}

# Mutual exclusion among b, c, d, e only
# (a is excluded — it is a signpost, not a hiding place)
{
  art(b) -> !art(c) & !art(d) & !art(e)
}
{
  art(c) -> !art(b) & !art(d) & !art(e)
}
{
  art(d) -> !art(b) & !art(c) & !art(e)
}
{
  art(e) -> !art(b) & !art(c) & !art(d)
}

# Query encodes the BDD above:
#   a=true  branch: art(b) | art(c)   i.e. check b, then c
#   a=false branch: art(d) | art(e)   i.e. check d, then e
Query: {
  (art(a) & (art(b) | art(c))) ^ (!art(a) & (art(d) | art(e)))
}
