# Define the universe.
location a22
location a11 
location a12 
location a21

# These "ground" to actions
#transition a11 a12 5.6
#transition a11 a21 1.0
#transition a12 a22 2.0
#transition a21 a22 12.3
transition a11 a21 2.0
transition a12 a11 2.0
transition a22 a12 2.0
transition a21 a22 2.0

observation-cost a22 1.5
observation-cost a11 1.25
observation-cost a21 0.5
observation-cost a12 0.5

# Things that your sensor will tell you
recognizable-property english
recognizable-property italian
recognizable-property dutch


# Still TODO: define custom
# aggregate-properties: 
#     mona-lisa => italian AND masterpiece AND portrait AND smirk

starting-location a11

# Formulas describing the world. 

# Facts have no bracket, but are still in braces:
{ english(a12) }

# A painting comes from exactly one country:
[?x]{ 
    ( english(?x)  & !(italian(?x) | dutch(?x)  )) |
    ( italian(?x)  & !(english(?x) | dutch(?x)  )) |
    (   dutch(?x)  & !(english(?x) | italian(?x))) 
}

## Queries:
Query: {  ((english(a21)) ^ (italian(a22))) | (english(a11) | dutch(a11)) }
#Query: {  (english(a21)) ^ (italian(a22)) }
