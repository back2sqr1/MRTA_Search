recognizable-property sculpture
recognizable-property painting
recognizable-property print
recognizable-property monochrome
recognizable-property yinkashonibare
recognizable-property josephbeuys 
recognizable-property marilyn-diptych 

starting-location m00


# Andy Warhol's  Marilyn Diptych is placed in one of 4 locations
{
  (marilyn-diptych(w01) & !(marilyn-diptych(w19) | marilyn-diptych(w20) | marilyn-diptych(w18))) | 
  (marilyn-diptych(w19) & !(marilyn-diptych(w20) | marilyn-diptych(w01) | marilyn-diptych(w18))) | 
  (marilyn-diptych(w20) & !(marilyn-diptych(w01) | marilyn-diptych(w19) | marilyn-diptych(w18))) |
  (marilyn-diptych(w18) & !(marilyn-diptych(w01) | marilyn-diptych(w19) | marilyn-diptych(w20)))  
}

