[?x]{ 
 marilyn-diptych(?x) -> (print(?x) & !monochrome(?x))
}



[?x]{ 
 monochrome(?x) -> !yinkashonibare(?x) 
}

[?x]{ 
 yinkashonibare(?x) -> !monochrome(?x) 
}

[?x]{ 
 yinkashonibare(?x) -> !josephbeuys(?x) 
}

[?x]{ 
 josephbeuys(?x) -> (!yinkashonibare(?x) & monochrome(?x) & sculpture(?x)) 
}

[?x]{ 
 josephbeuys(?x) -> (!yinkashonibare(?x)) 
}


# A piece comes from exactly one form:
[?x]{ 
    ( sculpture(?x)  & !(painting(?x) | print(?x)  )) |
    ( painting(?x)  & !(print(?x) | sculpture(?x)  )) |
    (  print(?x)  & !(sculpture(?x) | painting(?x))) 
}

# There is at least one painting
[E?x]{ 
    painting(?x)  
}
# There is at least one print
[E?x]{ 
    print(?x)  
}

#Query: [?x]{  (josephbeuys(?x) | yinkashonibare(?x)) }
Query: {  (marilyn-diptych(w01)) } 


