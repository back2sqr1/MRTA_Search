# Define the map with pin coordinates:
location locA at 0, 0
location locB at 1, 0
location loc01 at 0, 1
location loc02 at 1, 1
location loc03 at 2, 1
location loc04 at 3, 1
location loc05 at 0, 2
location loc06 at 1, 2
location loc07 at 2, 2
location loc08 at 3, 2
location loc09 at 0, 3
location loc10 at 1, 3
location loc11 at 2, 3
location loc12 at 3, 3
location loc13 at 0, 4
location loc14 at 1, 4
location loc15 at 2, 4

robots 2
robot robot1 starts-at locA
robot robot2 starts-at locB

recognizable-property marilyn-diptych 
recognizable-property painting
recognizable-property sculpture
recognizable-property corner
recognizable-property ell-shaped

# Constant facts have no braces:
!corner(locA) 
!corner(locB)
!corner(loc01)
!corner(loc02)
!corner(loc03)
!corner(loc04)
!corner(loc05)
!corner(loc06)
!corner(loc07)
!corner(loc08)
!corner(loc09)
!corner(loc10)
corner(loc11)
!corner(loc12)
!corner(loc13)
!corner(loc14)
corner(loc15)

!ell-shaped(locA)
!ell-shaped(locB)
!ell-shaped(loc01)
!ell-shaped(loc02)
!ell-shaped(loc03)
!ell-shaped(loc04)
!ell-shaped(loc05)
!ell-shaped(loc06)
ell-shaped(loc07)
ell-shaped(loc08)
!ell-shaped(loc09)
!ell-shaped(loc10)
!ell-shaped(loc11)
!ell-shaped(loc12)
!ell-shaped(loc13)
!ell-shaped(loc14)
!ell-shaped(loc15)

# This can only be in one of the big rooms loc15, loc08, loc07, loc06
{ 
  marilyn-diptych(loc15) | marilyn-diptych(loc06) | marilyn-diptych(loc07) | marilyn-diptych(loc08)
}

# But the preceeding didn't say that there are no other marilyns
[?u, ?v | ?u != ?v]{
marilyn-diptych(?u) -> !marilyn-diptych(?v)
}


[?x]{ 
 marilyn-diptych(?x) -> painting(?x)
}


# Each location is exactly one form
[?x]{ 
    ( painting(?x)  & !sculpture(?x)) |
    ( sculpture(?x)     & !painting(?x)) 
}

# There is at least one sculpture
[E?x]{ 
    sculpture(?x)  
}

# Go to the corner, vs. 6, 7, 8
Query: {  (marilyn-diptych(loc15)) }  







