# Scatter-Decision Archive
#
# Reduced-complexity version: 24 declared variables (8 locations x 3 props),
# 8 free variables after grounding.  All three new behaviors are preserved:
#
#   1. MULTI-LOCATION PROPERTY: 'index' is readable at node-ia AND node-ib;
#      'tag' is readable at node-ib AND node-tc.  OR logic applies — one
#      True reading is sufficient to resolve the routing question, so the
#      BDD short-circuits once the first True site is visited.
#
#   2. MULTI-PROPERTY LOCATION: node-ib carries BOTH 'index' AND 'tag'.
#      A single visit here can resolve two BDD levels at once.  If
#      index(node-ib)=T AND tag(node-ib)=T the planner knows both the
#      active doc pair AND which room in it is guaranteed — without
#      ever visiting node-ia or node-tc.
#
#   3. RANDOM POSITIONS: no wing/upper-lower structure; sifting starts
#      from scratch.
#
# Layout (irregular coordinates):
#
#   dH1(8,130)                                    dH2(95,120)
#
#      node-ia(14,92)         node-ib(72,84)   <- node-ib has index+tag
#                  node-tc(38,110)             <- node-tc has tag only
#
#                              base(50,50)
#
#       dL1(18,12)                         dL2(90,22)
#
# Complexity vs. original deep-archive:
#   Original : 12 locations x 3 props = 36 declared, 11 free variables
#   This file:  8 locations x 3 props = 24 declared,  8 free variables
#
# Decision structure:
#   (index-a=T OR index-b=T)   ->  high pair  {dH1, dH2}
#   (index-a=F AND index-b=F)  ->  low  pair  {dL1, dL2}
#
#   Within the active pair, tag picks the GUARANTEED room:
#   (tag-b=T OR tag-c=T)   ->  first room guaranteed  (dH1 or dL1)
#   (tag-b=F AND tag-c=F)  ->  second room guaranteed (dH2 or dL2)
#   The other room is uncertain, so XOR forces visiting both.

# LOCATIONS
location base    at  50,  50
location node-ia at  14,  92
location node-ib at  72,  84
location node-tc at  38, 110
location dH1     at   8, 130
location dH2     at  95, 120
location dL1     at  18,  12
location dL2     at  90,  22

# ROBOTS
robots 3
robot r1 starts-at base
robot r2 starts-at base
robot r3 starts-at base

# PROPERTIES
recognizable-property index
recognizable-property tag
recognizable-property doc

# GROUND FACTS: index only at node-ia and node-ib
!index(base)
!index(node-tc)
!index(dH1)
!index(dH2)
!index(dL1)
!index(dL2)

# GROUND FACTS: tag only at node-ib and node-tc  (node-ia has no tag)
!tag(base)
!tag(node-ia)
!tag(dH1)
!tag(dH2)
!tag(dL1)
!tag(dL2)

# GROUND FACTS: no doc at routing/observation nodes
!doc(base)
!doc(node-ia)
!doc(node-ib)
!doc(node-tc)

# WORLD CONSTRAINTS
# --- High / Low pair routing (OR logic across two index sites) ---
{
  (index(node-ia) | index(node-ib)) -> (!doc(dL1) & !doc(dL2))
}
{
  (!index(node-ia) & !index(node-ib)) -> (!doc(dH1) & !doc(dH2))
}

# --- Guaranteed room within the active pair (OR logic across two tag sites) ---
# High pair: tag true  -> dH1 guaranteed to have doc
{
  ((index(node-ia) | index(node-ib)) & (tag(node-ib) | tag(node-tc))) -> doc(dH1)
}
# High pair: tag false -> dH2 guaranteed to have doc
{
  ((index(node-ia) | index(node-ib)) & !tag(node-ib) & !tag(node-tc)) -> doc(dH2)
}
# Low pair: tag true   -> dL1 guaranteed to have doc
{
  (!index(node-ia) & !index(node-ib) & (tag(node-ib) | tag(node-tc))) -> doc(dL1)
}
# Low pair: tag false  -> dL2 guaranteed to have doc
{
  (!index(node-ia) & !index(node-ib) & !tag(node-ib) & !tag(node-tc)) -> doc(dL2)
}

# NOTE: only one room per pair is guaranteed; the other room may also have
# a doc.  XOR is therefore genuinely uncertain (True when exactly one room
# has doc, False when both do), so robots must visit both rooms in the pair.

# QUERY: XOR within the active pair forces both rooms to be visited
Query: {
  ((index(node-ia) | index(node-ib)) & (doc(dH1) ^ doc(dH2))) |
  (!index(node-ia) & !index(node-ib) & (doc(dL1) ^ doc(dL2)))
}
