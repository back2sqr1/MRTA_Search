# This can only be in one of the big rooms w15, w08, w07, w06
{ 
  (marilyn-diptych(w15) & !(marilyn-diptych(w06) | marilyn-diptych(w07) | marilyn-diptych(w08))) | 
  (marilyn-diptych(w06) & !(marilyn-diptych(w07) | marilyn-diptych(w08) | marilyn-diptych(w15))) | 
  (marilyn-diptych(w07) & !(marilyn-diptych(w08) | marilyn-diptych(w15) | marilyn-diptych(w06))) | 
  (marilyn-diptych(w08) & !(marilyn-diptych(w15) | marilyn-diptych(w06) | marilyn-diptych(w07)))   
}

# But the preceeding didn't say that there are no other marilyns
[?u, ?v | ?u != ?v]{
marilyn-diptych(?u) -> !marilyn-diptych(?v)
}


[?x]{ 
 marilyn-diptych(?x) -> painting(?x)
}


# A piece comes from exactly one form
[?x]{ 
    ( painting(?x)  & !sculpture(?x)) |
    ( sculpture(?x)     & !painting(?x)) 
}

# There is at least one painting
[E?x]{ 
    painting(?x)  
}
# There is at least one sculpture
[E?x]{ 
    sculpture(?x)  
}

Query: {  (marilyn-diptych(w15)) }  # Go to the corner, vs. 6, 7, 8

