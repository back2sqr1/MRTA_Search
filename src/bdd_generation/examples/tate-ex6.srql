# This can only be in one of the big rooms loc15, loc08, loc07, loc06
{ 
  marilyn-diptych(loc15) | marilyn-diptych(loc06) | marilyn-diptych(loc07) | marilyn-diptych(loc08)
}

# But the preceeding didn't say that there are no other marilyns
[?u, ?v | ?u != ?v]{
marilyn-diptych(?u) -> !marilyn-diptych(?v)
}


[?x]{ 
 marilyn-diptych(?x) -> painting(?x)
}


# Each location is exactly one form
[?x]{ 
    ( painting(?x)  & !sculpture(?x)) |
    ( sculpture(?x)     & !painting(?x)) 
}

# There is at least one sculpture
[E?x]{ 
    sculpture(?x)  
}

